# Anthropic Console API key — https://console.anthropic.com (Billing -> API keys).
# NOTE: a Claude Pro/Max subscription does NOT grant API access; you need a Console key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# APPTUTORIAL_HOTKEY=ctrl+shift+t
# (Avoid ctrl+alt+* - on many keyboards Windows treats Ctrl+Alt as AltGr and the hotkey
#  never fires. Prefer ctrl+shift+* or function keys.)
# APPTUTORIAL_DENYLIST=1password.exe,bitwarden.exe,keepass.exe
# APPTUTORIAL_TELEMETRY_PATH=telemetry.jsonl
