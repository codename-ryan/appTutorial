# appTutorial uses an OPEN-WEIGHT vision model over an OpenAI-compatible API.
# Default is a local Ollama server (private + free - screenshots never leave your machine).
#
# Setup (local, recommended):
#   1. Install Ollama from https://ollama.com
#   2. Pull a VISION model:  ollama pull qwen2.5vl
#      (alternatives: llama3.2-vision, minicpm-v - must support images)
#   3. Make sure Ollama is running (it serves http://localhost:11434 automatically).
#
# Defaults shown; uncomment to override.
# OPENWEIGHT_BASE_URL=http://localhost:11434/v1
# OPENWEIGHT_API_KEY=ollama
# OPENWEIGHT_IDENTIFY_MODEL=qwen2.5vl
# OPENWEIGHT_VERIFY_MODEL=qwen2.5vl
#
# To use a HOSTED open-weight provider instead (screenshots leave your machine), point the
# base URL at its OpenAI-compatible endpoint and set a real key, e.g. OpenRouter:
# OPENWEIGHT_BASE_URL=https://openrouter.ai/api/v1
# OPENWEIGHT_API_KEY=sk-or-...
# OPENWEIGHT_IDENTIFY_MODEL=qwen/qwen2.5-vl-72b-instruct

# Other optional overrides (defaults shown)
# APPTUTORIAL_HOTKEY=ctrl+shift+t
# (Avoid ctrl+alt+* - on many keyboards Windows treats Ctrl+Alt as AltGr and the hotkey
#  never fires. Prefer ctrl+shift+* or function keys.)
# APPTUTORIAL_DENYLIST=1password.exe,bitwarden.exe,keepass.exe
# APPTUTORIAL_TELEMETRY_PATH=telemetry.jsonl
